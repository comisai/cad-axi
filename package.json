{
  "name": "cad-axi",
  "version": "0.2.1",
  "description": "A command-line tool that lets AI agents read, create and edit CAD drawings. Works with DWG and DXF files.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cad-axi": "dist/bin/cad-axi.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comisai/cad-axi.git"
  },
  "homepage": "https://github.com/comisai/cad-axi#readme",
  "bugs": {
    "url": "https://github.com/comisai/cad-axi/issues"
  },
  "keywords": [
    "cad",
    "dwg",
    "dxf",
    "drawing",
    "quantity-takeoff",
    "construction",
    "cli",
    "ai-agents",
    "axi",
    "toon"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:contract": "node --test \"test/contract/**/*.test.ts\" \"test/axi/**/*.test.ts\" \"test/hostile/**/*.test.ts\"",
    "test:write": "node --test \"test/write/**/*.test.ts\"",
    "test:dist": "CAD_AXI_BIN=dist node --test \"test/contract/**/*.test.ts\" \"test/axi/**/*.test.ts\"",
    "check:package": "node scripts/check-package.mjs",
    "live": "node test/live/cad-live.mjs"
  },
  "dependencies": {
    "@toon-format/toon": "4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
